# CareerPath AI Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL URL)
# Format: postgresql://username:password@localhost:5432/careerpath_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerpath_db

# JWT Authentication Secret (Use strong 256-bit string in production)
JWT_SECRET=super_secure_careerpath_ai_jwt_secret_key_2026_hackathon_edition
JWT_EXPIRES_IN=7d

# Gemini LLM API Key (Backend only - never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend Origin for CORS
CLIENT_URL=http://localhost:5173
